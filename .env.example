# Public site URL (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://srdacademy.in

# Enquiry delivery via Resend (https://resend.com). Server-side only; never prefix with NEXT_PUBLIC_.
# Without both RESEND_API_KEY and ENQUIRY_TO_EMAIL the form validates but tells visitors it isn't connected yet.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=ask.srdacademy@gmail.com
# Must be an address on a domain you've verified in Resend.
ENQUIRY_FROM_EMAIL="SRD Academy website <enquiries@srdacademy.in>"
